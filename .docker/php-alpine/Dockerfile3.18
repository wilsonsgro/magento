FROM alpine:3.13.0

USER root

RUN apk --no-cache add \
php7 \
php7-pdo \
php7-pdo_mysql \
php7-mysqlnd \
php7-opcache \
php7-xml \
php7-simplexml \
php7-mcrypt \
php7-gd \
php7-intl \
php7-mbstring \
php7-phar \
php7-dom \
php7-session \
php7-xmlwriter \
php7-bcmath \
php7-tokenizer \
php7-json \
php7-sockets \
php7-iconv \
php7-xsl \
php7-curl \
php7-soap \
php7-zip \
php7-fpm \
php7-ctype \
php7-imap \
php7-xmlreader \
php7-fileinfo \
php7-sodium \
apache2 \
apache2-utils \
apache2-proxy \
busybox-extras \
bash \
curl \
coreutils \
fcgi \
fuse \
graphviz \
gcc \
git \
iputils \
jq \
libssh2 \
libssh2-dev \
mysql-client \
musl-dev \
net-tools \
netcat-openbsd \
patch \
python3 \
rsync \
ssmtp \
tcptraceroute \
tzdata \
unzip \
which
 
#lib causing issue with stock alpire repo version
RUN apk --no-cache add \
        libsodium \
        php7-apcu \
        php7-ssh2

RUN cp /usr/share/zoneinfo/Europe/Paris /etc/localtime

#fix for iconv alpine
RUN apk add --no-cache --repository https://dl-3.alpinelinux.org/alpine/v3.18/community/ --allow-untrusted gnu-libiconv
ENV LD_PRELOAD /usr/lib/preloadable_libiconv.so php

#Create php7 user
RUN chmod g=u /etc/passwd && \
addgroup -S php7 && adduser -S php7 -G php7

COPY start.sh /start.sh

RUN chmod 777 /start.sh

RUN mkdir -p /run/php-fpm && \
chown -R php7 /run/php-fpm \
 /var/www \
 /var/log/ && \
chmod -R 777 /var/www \
/var/log/

# install ioncube

RUN mkdir -p setup && cd setup && \
  curl -sSL https://downloads.ioncube.com/loader_downloads/ioncube_loaders_lin_x86-64.tar.gz -o ioncube.tar.gz && \
  tar -xf ioncube.tar.gz && \
  mv ioncube/ioncube_loader_lin_7.4.so /usr/lib/php7/modules/ && \
  echo 'zend_extension = /usr/lib/php7/modules/ioncube_loader_lin_7.4.so' >  /etc/php7/conf.d/00-ioncube.ini && \
  cd .. && rm -rf setup

# install locale

RUN apk add --no-cache \
    cmake make musl-dev gcc gettext-dev libintl \
    && wget https://gitlab.com/rilian-la-te/musl-locales/-/archive/master/musl-locales-master.zip \
    && unzip musl-locales-master.zip \
      && cd musl-locales-master \
      && cmake -DLOCALE_PROFILE=OFF -D CMAKE_INSTALL_PREFIX:PATH=/usr . && make && make install \
      && cd .. && rm -r musl-locales-master



apk add php81-pecl-xdebug

WORKDIR /var/www/

RUN mkdir -p /var/log/php-fpm \
/var/log/php7
RUN touch /var/log/php7/error.log
RUN chmod 777 /var/log/php7/error.log

EXPOSE 900

CMD /start.sh
