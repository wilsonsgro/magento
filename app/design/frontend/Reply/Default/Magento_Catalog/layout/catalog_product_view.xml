<page layout="1column" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock class="Magento\Catalog\Block\Product\View\Attributes" name="product.attributes" group="detailed_info">
            <arguments>
                <argument translate="true" name="title" xsi:type="string">More Information</argument>
                <argument name="sort_order" xsi:type="string">20</argument>
                <argument name="view_model" xsi:type="object">Reply\Example\Model\ViewModel\CustomViewModel</argument>
            </arguments>
        </referenceBlock>
    </body>
</page>


